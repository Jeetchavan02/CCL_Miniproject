# Local Development Environment Template
# Copy this file to .env for local testing (Do NOT commit .env with real credentials)
LOCAL_DEV=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=localpass
DB_NAME=lostfound_db
JWT_SECRET=local_development_jwt_secret_key_32_bytes_long
BUCKET=local-bucket
SNS_ARN=local-sns-arn
AWS_REGION=us-east-1
